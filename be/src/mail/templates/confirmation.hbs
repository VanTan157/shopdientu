<style>
  body { background: #f4f6f8; margin: 0; padding: 0; } .confirmation-container {
  max-width: 420px; margin: 48px auto; padding: 32px 28px 28px 28px;
  border-radius: 12px; background: #fff; box-shadow: 0 4px 24px rgba(25, 118,
