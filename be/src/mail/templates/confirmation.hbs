  .confirmation-container p { margin: 16px 0; font-size: 16px; color: #333;
  line-height: 1.6; } .confirmation-code { display: inline-block; background:
  #e3f2fd; color: #1976d2; font-size: 22px; font-weight: bold; letter-spacing:
